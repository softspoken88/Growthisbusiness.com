# Copy this file to .env.local for local development, and add the
# same variables in your Vercel project settings for production.

# Where /api/assessment forwards Growth Assessment submissions once
# you've connected a CRM, Zapier/Make catch hook, or automation
# platform. See README.md → "Connecting the assessment form".
ASSESSMENT_WEBHOOK_URL=

# Optional: if you send confirmation/notification emails from the
# API route directly (e.g. via Resend) instead of a webhook.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=hello@growthisbusiness.com
