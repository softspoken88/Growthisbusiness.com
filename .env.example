# Copy this file to .env.local for local development, and add the
# same variables in your Vercel project settings for production.

# Required for the Growth Assessment form to actually email
# submissions (via Resend) instead of just logging them. Get this
# from resend.com after creating an account. NOTE: Resend won't
# deliver to NOTIFY_EMAIL_TO until growthisbusiness.com is verified
# as a domain in Resend — see the comment at the top of
# app/api/assessment/route.ts.
RESEND_API_KEY=

# Who receives Growth Assessment notifications. Defaults to
# jcollins@growthisbusiness.com in code if this isn't set.
NOTIFY_EMAIL_TO=jcollins@growthisbusiness.com
